rules_version = '2';

// PicMe (EventSnap) — Production-Grade Storage Security Rules
// Membatasi unggahan hanya untuk format gambar valid, batas ukuran file 10MB, dan isolasi folder event

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidImage(maxSizeMB) {
      return request.resource.size <= maxSizeMB * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif|gif)');
    }

    // Path terstruktur utama untuk foto event: events/{eventId}/photos/{fileName}
    match /events/{eventId}/photos/{fileName} {
      // Foto publik untuk ditampilkan di Live Stream Wall & Galeri Tamu
      allow read: if true;

      // Unggah foto: harus authenticated (mendukung anonymous auth), maks 10MB, MIME type valid
      allow write: if isAuthenticated() && isValidImage(10);

      // Hapus foto: diizinkan bagi user terautentikasi (untuk mekanisme rollback atomik atau hapus foto sendiri/host)
      allow delete: if isAuthenticated();
    }

    // Path backward-compatibility: events/{eventId}/{uid}/{fileName}
    match /events/{eventId}/{uid}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == uid && isValidImage(10);
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }
  }
}
