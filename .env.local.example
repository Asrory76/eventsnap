# ============================================================
# EventSnap — Firebase Configuration
# ============================================================
# Salin file ini menjadi .env.local:
#   cp .env.local.example .env.local
#
# Isi semua variabel dari:
#   Firebase Console > Project settings > Your apps > Web app config
#
# Catatan: Variabel NEXT_PUBLIC_* akan ter-expose ke browser.
# Ini aman karena keamanan dijaga oleh Firestore & Storage rules,
# bukan oleh menyembunyikan config ini.
# ============================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================================
# Cloudinary Configuration (Penyimpanan Foto 100% Gratis)
# ============================================================
# Buat akun gratis di https://cloudinary.com (tanpa kartu kredit)
# Dapatkan di Settings > Upload > Add upload preset (Signing Mode: Unsigned)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=eventsnap
