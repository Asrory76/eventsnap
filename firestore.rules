rules_version = '2';

// PicMe (EventSnap) — Production-Grade Firestore Security Rules
// Menjaga integritas data multi-tenant, kuota foto atomik, otorisasi, dan validasi anti-spam

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions Standar & Anti-Spam ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incomingData() {
      return request.resource.data;
    }

    function existingData() {
      return resource.data;
    }

    function validString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isEventHost(eventData) {
      return isAuthenticated() && (
        request.auth.uid == eventData.hostId ||
        request.auth.uid == eventData.ownerUid
      );
    }

    function getEvent(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    // --- Events Collection ---
    match /events/{eventId} {
      // Siapa saja (termasuk tamu scanning QR) dapat membaca info event
      allow read: if true;

      // Hanya Host terautentikasi yang boleh membuat event baru
      // Validasi skema ketat & anti-spam (timestamp sinkron request.time)
      allow create: if isAuthenticated()
        && (incomingData().hostId == request.auth.uid || incomingData().ownerUid == request.auth.uid)
        && validString(incomingData().title, 1, 120)
        && (!('description' in incomingData()) || incomingData().description == null || validString(incomingData().description, 0, 1000))
        && (!('slug' in incomingData()) || incomingData().slug == null || validString(incomingData().slug, 1, 80))
        && (!('pin' in incomingData()) || incomingData().pin == null || validString(incomingData().pin, 0, 20))
        && incomingData().maxPhotoQuota is int
        && incomingData().maxPhotoQuota > 0
        && incomingData().maxPhotoQuota <= 50000
        && incomingData().usedPhotoQuota is int
        && incomingData().usedPhotoQuota == 0
        && incomingData().createdAt == request.time;

      // Update event:
      // 1. Host dapat mengubah konfigurasi event apa pun
      // 2. Transaksi upload foto tamu: increment usedPhotoQuota atomik
      // 3. Transaksi hapus foto: decrement usedPhotoQuota atomik
      allow update: if isEventHost(existingData())
        || (
          isAuthenticated()
          && existingData().status == 'active'
          && incomingData().diff(existingData()).affectedKeys().hasOnly(['usedPhotoQuota', 'updatedAt'])
          && incomingData().usedPhotoQuota == existingData().usedPhotoQuota + 1
          && incomingData().usedPhotoQuota <= existingData().maxPhotoQuota
        )
        || (
          isAuthenticated()
          && incomingData().diff(existingData()).affectedKeys().hasOnly(['usedPhotoQuota', 'updatedAt'])
          && incomingData().usedPhotoQuota == existingData().usedPhotoQuota - 1
          && incomingData().usedPhotoQuota >= 0
        );

      // Hanya Host yang boleh menghapus dokumen event
      allow delete: if isEventHost(existingData());

      // --- Photos Subcollection ---
      match /photos/{photoId} {
        // Galeri & Live Stream Wall dapat dibaca secara publik
        allow read: if true;

        // Unggah foto oleh Tamu atau Host:
        // - Harus terautentikasi (Anonymous atau Akun terdaftar)
        // - ID pengunggah sesuai sesi aktif
        // - Event harus berstatus 'active'
        // - Kuota belum terpenuhi
        // - Metadata media & anti-spam tervalidasi
        allow create: if isAuthenticated()
          && incomingData().uploadedBy == request.auth.uid
          && incomingData().eventId == eventId
          && incomingData().storagePath is string
          && incomingData().storagePath.size() > 0
          && incomingData().storagePath.size() <= 300
          && incomingData().url is string
          && incomingData().url.size() > 0
          && incomingData().url.size() <= 1000
          && (!('caption' in incomingData()) || incomingData().caption == null || validString(incomingData().caption, 0, 500))
          && (!('uploaderName' in incomingData()) || incomingData().uploaderName == null || validString(incomingData().uploaderName, 0, 50))
          && incomingData().fileSize is int
          && incomingData().fileSize > 0
          && incomingData().fileSize <= 10 * 1024 * 1024
          && incomingData().mimeType is string
          && incomingData().mimeType.matches('image/(jpeg|png|webp|heic|heif|gif)')
          && incomingData().createdAt == request.time
          && getEvent(eventId).status == 'active'
          && getEvent(eventId).usedPhotoQuota < getEvent(eventId).maxPhotoQuota;

        // Update foto:
        // 1. Host untuk moderasi (misal status approved/rejected)
        // 2. Tamu untuk counter komentar atomik (+1 / -1)
        // 3. Tamu untuk counter like atomik (+1 / -1)
        allow update: if isEventHost(getEvent(eventId))
          || (
            isAuthenticated()
            && getEvent(eventId).status == 'active'
            && incomingData().diff(existingData()).affectedKeys().hasOnly(['commentsCount'])
            && (incomingData().commentsCount == existingData().commentsCount + 1 || incomingData().commentsCount == existingData().commentsCount - 1)
          )
          || (
            isAuthenticated()
            && incomingData().diff(existingData()).affectedKeys().hasOnly(['likesCount'])
            && (incomingData().likesCount == existingData().likesCount + 1 || incomingData().likesCount == existingData().likesCount - 1)
          );

        // Hapus foto: Host event ATAU tamu pemilik foto yang bersangkutan
        allow delete: if isEventHost(getEvent(eventId))
          || (isAuthenticated() && existingData().uploadedBy == request.auth.uid);
      }

      // --- Comments Subcollection ---
      match /comments/{commentId} {
        // Komentar dan ucapan selamat dapat dibaca publik di Live Stream Wall
        allow read: if true;

        // Tambah komentar/ucapan:
        // - Tamu terautentikasi
        // - Event berstatus 'active'
        // - Validasi anti-spam (pesan 1-500 karakter, nama 1-50 karakter, createdAt == request.time)
        allow create: if isAuthenticated()
          && incomingData().authorUid == request.auth.uid
          && incomingData().eventId == eventId
          && validString(incomingData().message, 1, 500)
          && (!('authorName' in incomingData()) || incomingData().authorName == null || validString(incomingData().authorName, 1, 50))
          && incomingData().createdAt == request.time
          && getEvent(eventId).status == 'active';

        // Update komentar tidak diizinkan untuk menjaga keaslian feed live
        allow update: if false;

        // Hapus komentar: Host event atau pembuat komentar
        allow delete: if isEventHost(getEvent(eventId))
          || (isAuthenticated() && existingData().authorUid == request.auth.uid);
      }
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }
  }
}
